# Normalize all text files to LF.
* text=auto eol=lf

# Source formats
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.jsonl text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.txt text eol=lf

# Binary assets must never be normalized or diffed as text.
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.xz binary

# Derived artifacts (kept tracked on purpose, but hidden from linguist stats)
metadata/id-map.jsonl linguist-generated=true
